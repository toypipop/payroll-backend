# UAT deployment template. Copy this file to .env on the UAT host, then replace every placeholder.
# Do not commit the resulting .env or real passwords, URLs, or JWT secrets.
# UAT retains production safety settings because it contains shared, deployment-managed data.
PGHOST=postgres
PGPORT=5432
PGDATABASE=payrolldb_uat
PGUSER=payroll
PGPASSWORD=replace-with-a-uat-database-password
PGSSLMODE=disable
PGCHANNELBINDING=
DB_TIMEZONE=Asia/Bangkok
PORT=8000
FRONTEND_ORIGIN=https://payroll-uat.example.invalid
CORS_ALLOWED_ORIGINS=https://payroll-uat.example.invalid
APP_ENV=production
GIN_MODE=release
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
JWT_SECRET=replace-with-a-long-random-uat-secret
