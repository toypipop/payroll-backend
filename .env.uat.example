# UAT deployment template. Copy this file to .env on the UAT host, then replace every placeholder.
# Do not commit the resulting .env or real passwords, URLs, or JWT secrets.
# UAT retains production safety settings because it contains shared, deployment-managed data.
PGHOST=postgres
PGPORT=5432
PGDATABASE=payrolldb_uat
PGUSER=payroll
PGPASSWORD=replace-with-a-uat-database-password
PGSSLMODE=disable
PGCHANNELBINDING=
DB_TIMEZONE=Asia/Bangkok
PORT=8000
FRONTEND_ORIGIN=https://pay.getpipop.org
CORS_ALLOWED_ORIGINS=https://payroll-uat.example.invalid
# UAT intentionally permits `seed --mock --reset`; Gin release mode retains production cookie defaults.
APP_ENV=uat
GIN_MODE=release
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUSTED_PROXY_CIDRS=replace-with-payroll-frontend-network-cidr
JWT_SECRET=replace-with-a-long-random-uat-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-uat-bootstrap-password

# Per-process database pool; keep the sum across instances within the server budget.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
