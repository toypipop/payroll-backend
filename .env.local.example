# Local development template. Copy this file to .env before starting the backend.
# .env is local-only and must never be committed. Replace placeholder secrets.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=payrolldb
PGUSER=postgres
PGPASSWORD=change-me
PGSSLMODE=disable
PGCHANNELBINDING=
DB_TIMEZONE=Asia/Bangkok
PORT=8000
FRONTEND_ORIGIN=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
APP_ENV=development
GIN_MODE=debug
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_SECRET=replace-with-a-long-random-secret

# Per-process database pool; keep the sum across instances within the server budget.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
